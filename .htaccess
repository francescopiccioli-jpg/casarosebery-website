# Casa Rosebery — sito statico al posto di WordPress
# Ripristino: rimettere il vecchio .htaccess di WordPress ed eliminare index.html

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Forza HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.casaroseberyristorante.it%{REQUEST_URI} [L,R=301]

# 2. Dominio senza www -> www
RewriteCond %{HTTP_HOST} ^casaroseberyristorante\.it$ [NC]
RewriteRule ^ https://www.casaroseberyristorante.it%{REQUEST_URI} [L,R=301]

# 3a. Vecchi file del WordPress indicizzati da Google
#     PDF (era il menu) -> pagina menu; tutto il resto di wp-content -> rimosso definitivamente (410)
RewriteRule ^wp-content/.*\.pdf$ https://www.casaroseberyristorante.it/menu.html [L,R=301,NC]
RewriteRule ^wp-content(/|$) - [G,L,NC]

# 3. Blocca il vecchio WordPress (resta sul server ma non e' raggiungibile)
RewriteRule ^(wp-admin|wp-includes|_old_wordpress|_OLD)(/|$) - [F,L,NC]
RewriteRule \.php$ - [F,L]
RewriteRule ^(readme\.html|license\.txt|wp-config.*)$ - [F,L]

# 4. Bozza non pubblica
RewriteRule ^(casarosebery_site\.html|menu-src|eventi-src|eventi-privati-src|vini-src|en-src)(/|$) - [F,L]

# 4b. Menu PDF sospeso finché non vengono corretti gli allergeni (togliere questa riga per riattivarlo)
RewriteRule ^menu-casa-rosebery\.pdf$ - [F,L]

# 4c. Vecchi URL del menu (WordPress / QR code stampati) -> nuova pagina menu
RewriteRule ^(menu|menu-1|menu-2|il-menu|menu-casa-rosebery)/?$ https://www.casaroseberyristorante.it/menu.html [L,R=301,NC]

# 4d. Vecchie pagine WordPress ancora presenti su Google -> pagina o sezione corrispondente
RewriteRule ^chi-siamo/?$ https://www.casaroseberyristorante.it/#storia [L,R=301,NE,NC]
RewriteRule ^contatti/?$ https://www.casaroseberyristorante.it/#contatti [L,R=301,NE,NC]
RewriteRule ^(discover-our-new-menu|menu/[^/]+)/?$ https://www.casaroseberyristorante.it/menu.html [L,R=301,NC]
RewriteRule ^privacy-policy(-2)?/?$ https://www.casaroseberyristorante.it/privacy.html [L,R=301,NC]
# Pagine del tema WordPress che non sono mai state del ristorante -> rimosse (410)
RewriteRule ^(home-cloned|author|culinary-history|reception-bar)(/|$) - [G,L,NC]

# 5. Vecchi URL WordPress (pagine, articoli, categorie) -> home
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ https://www.casaroseberyristorante.it/ [L,R=301]
</IfModule>

# Intestazioni di sicurezza (solo HTTPS forzato, nessun effetto sull'aspetto del sito)
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=15552000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always unset X-Powered-By
</IfModule>

# Cache per immagini e file statici
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType text/html "access plus 1 hour"
</IfModule>
